# PaddockPulse environment variables. Copy to .env and fill in the values you need.
# run_all.py loads this file via python-dotenv. Only the keys for the providers you
# actually use are required.

# OpenRouter: required for event analysis, post generation and image prompt generation
OPENROUTER_API_KEY=

# OpenAI: required for the default image provider (gpt-image-1 with DALL-E 3 fallback)
OPENAI_API_KEY=
# Set to true to skip gpt-image-1 and go straight to DALL-E 3
# SKIP_GPT_IMAGE_1=false

# ElevenLabs: required for voiceovers
ELEVEN_LABS_API_KEY=

# Optional image providers
GOAPI_KEY=        # Midjourney via GoAPI (--provider midjourney)
GOOGLE_API_KEY=   # Google Imagen (--provider imagen)
HIVEAI_API_KEY=   # HiveAI Flux (--provider hiveai, and paddock_pulse/hiveai_demo.py)

# Optional stock photo sources used by paddock_pulse/photo_finder.py
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
