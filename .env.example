# FastAPI Settings
APP_ENV=development  # development, testing, production
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your_secret_key_here

# Instagram (Facebook Graph API)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_long_lived_facebook_access_token

# AI API Keys
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_api_key_here
STABILITY_API_KEY=your_stability_api_key
RUNWAYML_API_KEY=your_runwayml_api_key
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key  # Get this from https://elevenlabs.io/
GOAPI_KEY=your_goapi_key_here  # Get this from https://goapi.ai/ for Midjourney integration

# Media and Storage
MEDIA_DIR=./media
DATA_CACHE_DIR=./data/cache

# Budget Control
DAILY_BUDGET_CAP=5.0  # in USD
ADMIN_EMAIL=admin@example.com  # for budget alerts

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# OpenRouter API key (required for LLM analysis and post generation)
OPENROUTER_API_KEY=your_api_key_here

# FastF1 cache location (optional, defaults to 'data/fastf1_cache')
# FASTF1_CACHE_DIR=path/to/cache/directory

# Output directory for generated posts (optional, defaults to 'output')
# OUTPUT_DIR=path/to/output/directory 