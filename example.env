# PaddockPulse Environment Variables
# Rename this file to .env and add your API keys

# PaddockPulse API Keys

# For post generation (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# For image generation (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Uncomment and edit the following line if you need to set a proxy
# HTTP_PROXY=http://your-proxy-url:port 